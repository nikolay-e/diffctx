{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiffContextOutput",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`diffctx.context.v1`: the schema a consumer validates against; the\ndocument below is generated from this type and pinned by test.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "commit_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_messages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_count": {
      "description": "Commits in the range when that is more than `commit_messages` lists.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangeEntry"
      }
    },
    "deleted_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "renamed_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RenameEntry"
      }
    },
    "lockfile_changes": {
      "description": "Lock files touched by the range. Paths only — the raw hunks are\nthousands of tokens of checksum churn for one line of signal (#112).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignored_changes": {
      "description": "Changed files withheld by ignore rules. Silent exclusion misreads as\n\"the diff did not touch this\" (#188: a reviewer filed \"no tests\"\nagainst a change whose tests the tool had filtered).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_excluded_count": {
      "description": "Files excluded by `.diffctx/ignore` or secret-path policy — count\nonly, see `ScoredState::policy_excluded_count`.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "fragment_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FragmentEntry"
      }
    },
    "provenance": {
      "description": "Absent only for outputs no pipeline run produced (the in-memory\nharness, an empty tree).",
      "anyOf": [
        {
          "$ref": "#/$defs/ProvenanceV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "description": "Present only when a limit stopped the run short: what stopped it and\nwhat was consumed. A complete run's output carries no block.",
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "redactions": {
      "description": "Present only when the sanitizer replaced a credential-shaped string\nsomewhere in this artifact — fragment text, a commit message.",
      "anyOf": [
        {
          "$ref": "#/$defs/Redactions"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "name",
    "type",
    "fragment_count",
    "fragments"
  ],
  "$defs": {
    "ChangeEntry": {
      "description": "One changed file's inventory row: what kind of change it carries and\nwhether anything of it made it into the output. The row exists for every\nchanged file whatever the budget — an omission is stated, never implied.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/ChangeClass"
        },
        "represented": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "class",
        "represented"
      ]
    },
    "ChangeClass": {
      "oneOf": [
        {
          "description": "Hand-written, multi-line or otherwise substantive.",
          "type": "string",
          "const": "content"
        },
        {
          "description": "Not classified with confidence; ranked with `Content`.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "One-line pin/tag/version/digest edits of the kind an updater writes.",
          "type": "string",
          "const": "mechanical"
        },
        {
          "description": "A file whose header says it is generated.",
          "type": "string",
          "const": "generated"
        }
      ]
    },
    "RenameEntry": {
      "description": "One rename as the labelled pair the artifact renders.",
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "FragmentEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "lines": {
          "type": "string"
        },
        "role": {
          "description": "`Some(\"changed\")` for fragments overlapping the diff hunks; omitted\n(treated as supporting context) otherwise. This is the single signal a\nreader needs to tell the change apart from its context.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "lines",
        "kind"
      ]
    },
    "ProvenanceV1": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "input": {
          "$ref": "#/$defs/Input"
        },
        "effective_config_hash": {
          "type": "string"
        },
        "effective_config": {
          "description": "The full record, ~500 tokens, only under `DIFFCTX_PROVENANCE=full`:\nthe hash identifies the configuration on every run, and the record\nis reproducible from the same build and environment.",
          "anyOf": [
            {
              "$ref": "#/$defs/EffectiveConfigV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_limits": {
          "description": "The caps in force; with the full record only, the hash covers them.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceBudget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "engine",
        "input",
        "effective_config_hash"
      ]
    },
    "Engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Input": {
      "type": "object",
      "properties": {
        "diff_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "base": {
          "description": "Resolved object ids, so the record still names the input after the\nref moves. `head` is absent when the right side of the diff is the\nworking tree — a bare `--diff`, `--diff HEAD~2`, a duration window.",
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "working_tree": {
          "type": "boolean"
        }
      },
      "required": [
        "working_tree"
      ]
    },
    "EffectiveConfigV1": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "scoring": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "alpha": {
          "description": "The damping the run used: the CLI/API argument, which outranks\n`DIFFCTX_OP_PPR_ALPHA` (recorded under `ppr.alpha`).",
          "type": "number",
          "format": "double"
        },
        "graph_depth": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "bm25_discovery_top_k": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "file_admission": {
          "type": "boolean"
        },
        "commit_signal": {
          "type": "boolean"
        },
        "resources": {
          "description": "Every cap the run is held to. A cap that binds changes the artifact,\nso the caps are part of the configuration and of its hash.",
          "$ref": "#/$defs/ResourceBudget"
        },
        "selection": {
          "$ref": "#/$defs/SelectionParams"
        },
        "rescue": {
          "$ref": "#/$defs/RescueParams"
        },
        "boltzmann": {
          "$ref": "#/$defs/BoltzmannParams"
        },
        "ego": {
          "$ref": "#/$defs/EgoParams"
        },
        "rrf_k": {
          "type": "number",
          "format": "double"
        },
        "pit": {
          "$ref": "#/$defs/PitParams"
        },
        "ppr": {
          "$ref": "#/$defs/PprParams"
        },
        "utility": {
          "$ref": "#/$defs/UtilityParams"
        },
        "filtering": {
          "$ref": "#/$defs/FilteringParams"
        },
        "needs": {
          "$ref": "#/$defs/NeedsParams"
        },
        "tokenizer": {
          "$ref": "#/$defs/TokenizerParams"
        },
        "profiles": {
          "$ref": "#/$defs/Profiles"
        },
        "overrides": {
          "description": "The `DIFFCTX_*` names set in the environment that this config read,\nwith their raw values. Excluded from the hash: two spellings of one\nvalue (\"0.4\" and \"0.40\") are one configuration.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "scoring",
        "objective",
        "alpha",
        "graph_depth",
        "bm25_discovery_top_k",
        "file_admission",
        "commit_signal",
        "resources",
        "selection",
        "rescue",
        "boltzmann",
        "ego",
        "rrf_k",
        "pit",
        "ppr",
        "utility",
        "filtering",
        "needs",
        "tokenizer",
        "profiles",
        "overrides"
      ]
    },
    "ResourceBudget": {
      "description": "Every cap a run is held to. `max_wall_secs` is the `--timeout`; the rest\nbound memory, which the wall clock alone never did — 38M edge\ncontributions took 11 GB before a single one was deduplicated (#196).",
      "type": "object",
      "properties": {
        "max_wall_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_source_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_file_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_changed_file_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_candidate_files": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_fragments_per_file": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_edge_contributions": {
          "description": "Edge emissions counted BEFORE deduplication: the number that owns the\nmemory, and the one a builder cannot see past its own output.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_out_edges_per_node": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_needs": {
          "description": "Information needs mined from the diff. Every candidate is scored\nagainst every need, so an unbounded need set from a repository-sized\ndiff made selection quadratic (413 s on this repo's own history).",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "max_wall_secs",
        "max_source_bytes",
        "max_file_bytes",
        "max_changed_file_bytes",
        "max_candidate_files",
        "max_fragments_per_file",
        "max_edge_contributions",
        "max_out_edges_per_node",
        "max_needs"
      ]
    },
    "SelectionParams": {
      "type": "object",
      "properties": {
        "core_budget_fraction": {
          "type": "number",
          "format": "double"
        },
        "r_cap_min": {
          "type": "number",
          "format": "double"
        },
        "per_file_budget_fraction": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "core_budget_fraction",
        "r_cap_min",
        "per_file_budget_fraction"
      ]
    },
    "RescueParams": {
      "type": "object",
      "properties": {
        "budget_fraction": {
          "type": "number",
          "format": "double"
        },
        "min_score_percentile": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "budget_fraction",
        "min_score_percentile"
      ]
    },
    "BoltzmannParams": {
      "type": "object",
      "properties": {
        "calibration_tolerance": {
          "type": "number",
          "format": "double"
        },
        "bisect_iters": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "calibration_tolerance",
        "bisect_iters"
      ]
    },
    "EgoParams": {
      "type": "object",
      "properties": {
        "identifier_overlap_epsilon": {
          "type": "number",
          "format": "double"
        },
        "per_hop_decay": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "identifier_overlap_epsilon",
        "per_hop_decay"
      ]
    },
    "PitParams": {
      "type": "object",
      "properties": {
        "blend": {
          "type": "number",
          "format": "double"
        },
        "agreement_bonus": {
          "type": "number",
          "format": "double"
        },
        "agreement_top_k": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "shape": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        }
      },
      "required": [
        "blend",
        "agreement_bonus",
        "agreement_top_k",
        "shape",
        "transform"
      ]
    },
    "PprParams": {
      "type": "object",
      "properties": {
        "alpha": {
          "type": "number",
          "format": "double"
        },
        "forward_blend": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "alpha",
        "forward_blend"
      ]
    },
    "UtilityParams": {
      "type": "object",
      "properties": {
        "eta": {
          "type": "number",
          "format": "double"
        },
        "structural_bonus_weight": {
          "type": "number",
          "format": "double"
        },
        "r_cap_sigma": {
          "type": "number",
          "format": "double"
        },
        "proximity_decay": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "eta",
        "structural_bonus_weight",
        "r_cap_sigma",
        "proximity_decay"
      ]
    },
    "FilteringParams": {
      "type": "object",
      "properties": {
        "proximity_half_decay": {
          "type": "number",
          "format": "double"
        },
        "definition_proximity_half_decay": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "proximity_half_decay",
        "definition_proximity_half_decay"
      ]
    },
    "NeedsParams": {
      "type": "object",
      "properties": {
        "min_rel_for_bonus": {
          "type": "number",
          "format": "double"
        },
        "relatedness_bonus": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "min_rel_for_bonus",
        "relatedness_bonus"
      ]
    },
    "TokenizerParams": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/TokenizerId"
        },
        "safety_factor": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "safety_factor"
      ]
    },
    "TokenizerId": {
      "description": "The accounting unit every budget, envelope charge and `token_count` is\nexpressed in. A budget of `N` means `N` tokens under THIS tokenizer; no\nmodel-specific tokenizer is emulated, and the id travels in provenance so\na consumer counting against a different model knows what it is converting.",
      "type": "string",
      "enum": [
        "o200k_base"
      ]
    },
    "Profiles": {
      "type": "object",
      "properties": {
        "scoring": {
          "type": "string"
        },
        "edge_weights": {
          "type": "string"
        },
        "parser": {
          "type": "string"
        }
      },
      "required": [
        "scoring",
        "edge_weights",
        "parser"
      ]
    },
    "Selection": {
      "type": "object",
      "properties": {
        "budget_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "budget_requested": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tau": {
          "type": "number",
          "format": "double"
        },
        "gate": {
          "type": "string"
        }
      },
      "required": [
        "budget_tokens",
        "tau",
        "gate"
      ]
    },
    "CoverageReport": {
      "description": "The disclosure block of an artifact whose run hit a limit: absent when\nnothing limited the run, so a complete run's output is unchanged.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "limit_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LimitReason"
          }
        },
        "resources": {
          "$ref": "#/$defs/ResourceUsage"
        },
        "lossy_files": {
          "description": "Files that were not UTF-8 and were decoded with replacement\ncharacters (`NonUtf8Content`): their symbols and identifiers may be\ntruncated at the first non-ASCII byte.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "limit_reasons",
        "resources"
      ]
    },
    "LimitReason": {
      "description": "Why a run did not do everything it could have. One vocabulary for every\nphase; consumers read `coverage.limit_reasons` and never a per-subsystem\nboolean.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "file_too_large",
            "total_byte_limit",
            "candidate_limit",
            "edge_contribution_limit",
            "edge_limit",
            "need_limit",
            "discovery_truncated",
            "diffusion_truncated",
            "deadline",
            "evidence_budget_exceeded",
            "selection_budget_exceeded",
            "sanitization_redaction"
          ]
        },
        {
          "description": "A file cut to `max_fragments_per_file`: what the diff touched survives\nthe cut, the rest is the longest fragments only.",
          "type": "string",
          "const": "fragment_limit"
        },
        {
          "description": "A changed or context file that was not UTF-8 and was decoded lossily;\n`coverage.lossy_files` names them.",
          "type": "string",
          "const": "non_utf8_content"
        }
      ]
    },
    "ResourceUsage": {
      "description": "What the run consumed, for the coverage block. Deterministic for a given\ninput and configuration (counts, not clocks).",
      "type": "object",
      "properties": {
        "source_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "parsed_files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "candidate_files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "edge_contributions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "final_edges": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "source_bytes",
        "parsed_files",
        "candidate_files",
        "edge_contributions",
        "final_edges"
      ]
    },
    "Redactions": {
      "description": "What the sanitizer removed from one artifact.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "categories": {
          "description": "Distinct shapes matched, in the order first seen.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "count",
        "categories"
      ]
    }
  }
}
