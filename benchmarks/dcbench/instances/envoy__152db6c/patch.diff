+
+// [#protodoc-title: Istio stats HTTP filter]
+//
+// Istio stats HTTP filter for collecting and reporting metrics.
+// [#extension: envoy.filters.http.istio_stats]
+
+enum MetricType {
+  COUNTER = 0;
+  GAUGE = 1;
+  HISTOGRAM = 2;
+}
+
+// Specifies the proxy deployment type.
+enum Reporter {
+  // Default value is inferred from the listener direction, as either client or
+  // server sidecar.
+  UNSPECIFIED = 0;
