diff --git a/src/Components/Endpoints/src/DependencyInjection/EndpointHtmlRenderer.PrerenderState.cs b/src/Components/Endpoints/src/DependencyInjection/EndpointHtmlRenderer.PrerenderState.cs
new file mode 100644
index 0000000000..49935da703
