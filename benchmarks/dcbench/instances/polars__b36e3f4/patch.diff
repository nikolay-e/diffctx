+
+macro_rules! det_hash_prone_order {
+    ($self:expr, $other:expr) => {{
+        // The shortest relation will be used to create a hash table.
+        let left_first = $self.len() > $other.len();
+        let a;
+        let b;
+        if left_first {
+            a = $self;
+            b = $other;
+        } else {
+            b = $self;
+            a = $other;
+        }
+
+        (a, b, !left_first)
+    }};
+}
