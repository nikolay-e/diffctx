+				act.Response = resp.Msg
+			}
+
+			if diff := cmp.Diff(test.Expectation, act, cmpopts.IgnoreUnexported(v1.GetIDTokenResponse{})); diff != "" {
+				t.Errorf("GetIDToken() mismatch (-want +got):\n%s", diff)
+			}
+		})
