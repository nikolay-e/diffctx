+#[pyclass(name = "RollingFunction", eq, frozen, skip_from_py_object)]
+#[derive(Copy, Clone, PartialEq)]
+pub enum PyRollingFunction {
+    Min,
+    Max,
+    Mean,
+    Sum,
+    Quantile,
+    Var,
+    Std,
+    Rank,
+    Skew,
+    Kurtosis,
+}
+
+#[pymethods]
+impl PyRollingFunction {
+    fn __hash__(&self) -> isize {
+        *self as isize
+    }
+}
