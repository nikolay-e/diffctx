         raise Gitlab::Access::AccessDeniedError
       end
@@ -10,7 +10,7 @@ def execute(build)
       # Try to enqueue the build, otherwise create a duplicate.
       #
       if build.enqueue
-        build.tap { |action| action.update(user: current_user) }
