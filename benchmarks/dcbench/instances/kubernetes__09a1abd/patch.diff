+	if ai < 24 {
+		return
+	}
+	if ai == 24 {
+		val = uint64(d.data[d.off])
+		d.off++
+		return
+	}
+	if ai == 25 {
+		val = uint64(binary.BigEndian.Uint16(d.data[d.off : d.off+2]))
+		d.off += 2
+		return
+	}
+	if ai == 26 {
+		val = uint64(binary.BigEndian.Uint32(d.data[d.off : d.off+4]))
+		d.off += 4
+		return
+	}
+	if ai == 27 {
+		val = binary.BigEndian.Uint64(d.data[d.off : d.off+8])
+		d.off += 8
+		return
+	}
