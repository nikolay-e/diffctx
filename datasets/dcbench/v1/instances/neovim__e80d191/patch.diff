index e07ba21fe..52c7aa1ac 100644
--- a/src/nvim/window.c
+++ b/src/nvim/window.c
@@ -7827,3 +7827,89 @@ win_T *lastwin_nofloating(tabpage_T *tp)
   }
   return res;
 }
