+
+    it('preserves tab order when entering new tabs', function()
+      local tab1 = api.nvim_get_current_tabpage()
+      command('tabnew')
+      local tab2 = api.nvim_get_current_tabpage()
+
+      -- Create new tab with enter=true, should insert after current (tab2)
