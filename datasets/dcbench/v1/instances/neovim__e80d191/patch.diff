+
+      -- Insert at position 2 (before tab2, which becomes new position 2)
+      local new_at_pos2 = api.nvim_open_tabpage(0, {
+        enter = false,
+        after = 2,
+      })
+
+      local final_result = api.nvim_list_tabpages()
+      eq(7, #final_result)
+      eq({
+        tabs[1],
+        new_at_pos2,
+        tabs[2],
+        tabs[3],
+        new_after_current,
+        tabs[4],
+        tabs[5],
