+        renderer.RenderRootComponent(componentId, parameters);
+
+        var batch = renderer.Batches.Single();
+        Assert.DoesNotContain(batch.ReferenceFrames, f => f.FrameType == RenderTree.RenderTreeFrameType.Text);
