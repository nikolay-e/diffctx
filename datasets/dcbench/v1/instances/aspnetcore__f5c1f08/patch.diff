+public class EnvironmentBoundaryTest
+{
+    [Theory]
+    [InlineData("Development", "Development")]
+    [InlineData("development", "Development")]
+    [InlineData("DEVELOPMENT", "Development")]
+    [InlineData(" development", "Development")]
+    [InlineData("development ", "Development")]
+    [InlineData(" development ", "Development")]
