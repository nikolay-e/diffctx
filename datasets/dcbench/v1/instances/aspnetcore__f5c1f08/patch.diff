+        var (renderer, componentId) = CreateEnvironmentBoundaryComponent("Development");
+
+        var parameters = ParameterView.FromDictionary(new Dictionary<string, object>
+        {
+            { nameof(EnvironmentBoundary.Include), "Development" },
