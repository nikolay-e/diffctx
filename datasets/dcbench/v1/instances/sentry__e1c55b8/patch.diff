+    startSpan: vi.fn(SentryReact.startSpan),
+    finishSpan: vi.fn(),
+    lastEventId: vi.fn(),
+    getClient: vi.fn(SentryReact.getClient),
+    getCurrentScope: vi.fn(SentryReact.getCurrentScope),
+    withScope: vi.fn(SentryReact.withScope),
