+ConfigStore.loadInitialData(ConfigFixture());
+
+// Default browser timezone to UTC
+vi.spyOn(Intl.DateTimeFormat.prototype, 'resolvedOptions').mockImplementation(() => ({
+  locale: 'en-US',
+  calendar: 'gregory',
+  numberingSystem: 'latn',
