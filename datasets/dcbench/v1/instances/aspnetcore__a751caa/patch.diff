diff --git a/src/Components/test/testassets/Components.TestServer/RazorComponents/Pages/Forms/ClientValidation/ServerRenderedMessages.razor b/src/Components/test/testassets/Components.TestServer/RazorComponents/Pages/Forms/ClientValidation/ServerRenderedMessages.razor
new file mode 100644
index 0000000000..602f1fba43
--- /dev/null
+++ b/src/Components/test/testassets/Components.TestServer/RazorComponents/Pages/Forms/ClientValidation/ServerRenderedMessages.razor
@@ -0,0 +1,36 @@
+@page "/forms/client-validation/server-rendered-messages"
+
+@*
+    Simulates Blazor SSR rendering after a POST with server-side validation errors.
+    The first <div> for a field has data-valmsg-for (JS manages it); the second is a plain
+    sibling (extra server-rendered error). JS should remove the sibling when client validation
+    runs and the field becomes valid or shows a different client-side error.
+*@
+
+<h2 id="page-title">Server-rendered validation messages</h2>
+
+<style>
+    .validation-message { color: red; }
+    .field-validation-error { color: red; }
+    .field-validation-valid { display: none; }
+</style>
+
+<form id="test-form" method="post">
+    <div>
+        <input id="name" name="Name" type="text"
+               data-val="true"
+               data-val-required="Name is required." />
+        <div class="validation-message" data-valmsg-for="Name" data-valmsg-replace="true">Name is required.</div>
+        <div class="validation-message">Name must be at least 2 characters.</div>
+    </div>
+
+    <div>
+        <input id="email" name="Email" type="text"
+               data-val="true"
+               data-val-required="Email is required."
+               data-val-email="Invalid email." />
+        <div class="validation-message" data-valmsg-for="Email" data-valmsg-replace="true">Email is required.</div>
+    </div>
+
+    <button type="submit" id="submit">Submit</button>
+</form>
diff --git a/src/Components/test/testassets/Components.TestServer/RazorComponents/Pages/Forms/ClientValidation/Timing.razor b/src/Components/test/testassets/Components.TestServer/RazorComponents/Pages/Forms/ClientValidation/Timing.razor
new file mode 100644
index 0000000000..6330b8c6d3
--- /dev/null
+++ b/src/Components/test/testassets/Components.TestServer/RazorComponents/Pages/Forms/ClientValidation/Timing.razor
@@ -0,0 +1,40 @@
+@page "/forms/client-validation/timing"
+
+<h2 id="page-title">Validation triggers</h2>
+
+<style>
+    .field-validation-error { color: red; }
+    .field-validation-valid { display: none; }
+</style>
+
+<form id="test-form" method="post">
+    @* Default: change + gated input *@
+    <input id="default-field" name="Default" type="text"
+           data-val="true"
+           data-val-required="Default is required." />
+    <span data-valmsg-for="Default" data-valmsg-replace="true"></span>
+
+    @* data-valevent="submit": only validated on form submit *@
+    <input id="submit-only" name="SubmitOnly" type="text"
+           data-val="true"
+           data-val-required="SubmitOnly is required."
+           data-valevent="submit" />
+    <span data-valmsg-for="SubmitOnly" data-valmsg-replace="true"></span>
+
+    @* data-valevent="change": only validated on change/blur, never on input *@
+    <input id="change-only" name="ChangeOnly" type="text"
+           data-val="true"
+           data-val-required="ChangeOnly is required."
+           data-valevent="change" />
+    <span data-valmsg-for="ChangeOnly" data-valmsg-replace="true"></span>
+
+    @* data-valevent="input": always validated on every keystroke *@
+    <input id="input-eager" name="InputEager" type="text"
+           data-val="true"
+           data-val-required="InputEager is required."
+           data-valevent="input" />
+    <span data-valmsg-for="InputEager" data-valmsg-replace="true"></span>
+
+    <button type="submit" id="submit">Submit</button>
+    <button type="reset" id="reset">Reset</button>
+</form>
