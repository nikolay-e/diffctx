From 3b6875ae98794c200b2227f303b69b1c9219debd Mon Sep 17 00:00:00 2001
From: gab23r <106454081+gab23r@users.noreply.github.com>
Date: Mon, 4 May 2026 16:35:24 +0200
Subject: [PATCH] feat: Add `null_on_oob` in {Expr/Series}.gather (#27327)

Co-authored-by: gabriel <gabriel.g.robin@airbus.com>
Co-authored-by: Orson Peters <orsonpeters@gmail.com>
---
 crates/polars-lazy/src/tests/aggregations.rs  |  2 +-
 crates/polars-plan/src/dsl/mod.rs             |  4 +--
 crates/polars-python/src/expr/general.rs      |  5 ++--
 .../tests/it/lazy/projection_queries.rs       |  2 +-
 py-polars/src/polars/_plr.pyi                 |  4 +--
 py-polars/src/polars/expr/expr.py             | 27 +++++++++++++++++--
 py-polars/src/polars/series/series.py         | 20 +++++++++++++-
 .../tests/unit/operations/test_gather.py      | 14 ++++++++++
 8 files changed, 67 insertions(+), 11 deletions(-)

diff --git a/crates/polars-lazy/src/tests/aggregations.rs b/crates/polars-lazy/src/tests/aggregations.rs
index eb7fc9d50..a044bf472 100644
--- a/crates/polars-lazy/src/tests/aggregations.rs
+++ b/crates/polars-lazy/src/tests/aggregations.rs
@@ -466,7 +466,7 @@ fn take_aggregations() -> PolarsResult<()> {
         .agg([
             // keep the head as it test slice correctness
             col("book")
-                .gather(col("count").arg_sort(true, false).head(Some(2)))
+                .gather(col("count").arg_sort(true, false).head(Some(2)), false)
                 .alias("ordered"),
         ])
         .sort(["user"], Default::default())
diff --git a/crates/polars-plan/src/dsl/mod.rs b/crates/polars-plan/src/dsl/mod.rs
index a13c1c5c3..ecb72d918 100644
--- a/crates/polars-plan/src/dsl/mod.rs
+++ b/crates/polars-plan/src/dsl/mod.rs
@@ -359,12 +359,12 @@ impl Expr {
     }
 
     /// Take the values by idx.
-    pub fn gather<E: Into<Expr>>(self, idx: E) -> Self {
+    pub fn gather<E: Into<Expr>>(self, idx: E, null_on_oob: bool) -> Self {
         Expr::Gather {
             expr: Arc::new(self),
             idx: Arc::new(idx.into()),
             returns_scalar: false,
-            null_on_oob: false,
+            null_on_oob,
         }
     }
 
diff --git a/crates/polars-python/src/expr/general.rs b/crates/polars-python/src/expr/general.rs
index 2b5a8305f..7a8948d22 100644
--- a/crates/polars-python/src/expr/general.rs
+++ b/crates/polars-python/src/expr/general.rs
@@ -355,8 +355,9 @@ impl PyExpr {
             .into()
     }
 
-    fn gather(&self, idx: Self) -> Self {
-        self.inner.clone().gather(idx.inner).into()
+    #[pyo3(signature = (idx, null_on_oob=false))]
+    fn gather(&self, idx: Self, null_on_oob: bool) -> Self {
+        self.inner.clone().gather(idx.inner, null_on_oob).into()
     }
 
     #[pyo3(signature = (idx, null_on_oob=false))]
diff --git a/crates/polars/tests/it/lazy/projection_queries.rs b/crates/polars/tests/it/lazy/projection_queries.rs
index 536629d6b..1d59cf6e7 100644
--- a/crates/polars/tests/it/lazy/projection_queries.rs
+++ b/crates/polars/tests/it/lazy/projection_queries.rs
@@ -119,7 +119,7 @@ fn test_projection_5086() -> PolarsResult<()> {
         .select([
             col("a"),
             col("b")
-                .gather("c")
+                .gather("c", false)
                 .cum_sum(false)
                 .over([col("a")])
                 .unwrap()
diff --git a/py-polars/src/polars/_plr.pyi b/py-polars/src/polars/_plr.pyi
index 51efc690d..be837766f 100644
--- a/py-polars/src/polars/_plr.pyi
+++ b/py-polars/src/polars/_plr.pyi
@@ -1279,12 +1279,12 @@ class PyExpr:
     def arg_min(self) -> PyExpr: ...
     def index_of(self, element: PyExpr) -> PyExpr: ...
     def search_sorted(self, element: PyExpr, side: Any, descending: bool) -> PyExpr: ...
-    def gather(self, idx: PyExpr) -> PyExpr: ...
+    def gather(self, idx: PyExpr, null_on_oob: bool) -> PyExpr: ...
     def get(
         self,
         idx: PyExpr,
         *,
-        null_on_oob: bool = False,
+        null_on_oob: bool,
     ) -> PyExpr: ...
     def sort_by(
         self,
diff --git a/py-polars/src/polars/expr/expr.py b/py-polars/src/polars/expr/expr.py
index 2f5ed0092..bac349d8a 100644
--- a/py-polars/src/polars/expr/expr.py
+++ b/py-polars/src/polars/expr/expr.py
@@ -2881,7 +2881,10 @@ class Expr:
         )
 
     def gather(
-        self, indices: int | Sequence[int] | IntoExpr | Series | np.ndarray[Any, Any]
+        self,
+        indices: int | Sequence[int] | IntoExpr | Series | np.ndarray[Any, Any],
+        *,
+        null_on_oob: bool = False,
     ) -> Expr:
         """
         Take values by index.
@@ -2890,6 +2893,11 @@ class Expr:
         ----------
         indices
             An expression that leads to a UInt32 dtyped Series.
+        null_on_oob
+            Behavior if an index is out of bounds:
+
+            - True  -> set the result to null
+            - False -> raise an error
 
         Returns
         -------
@@ -2927,6 +2935,21 @@ class Expr:
         │ one   ┆ [2, 98]   │
         │ two   ┆ [4, 99]   │
         └───────┴───────────┘
+
+        Use `null_on_oob=True` to return null for out-of-bounds indices.
+
+        >>> df = pl.DataFrame({"a": [1, 2, 3]})
+        >>> df.select(pl.col("a").gather([0, 1, 10], null_on_oob=True))
+        shape: (3, 1)
+        ┌──────┐
+        │ a    │
+        │ ---  │
+        │ i64  │
+        ╞══════╡
+        │ 1    │
+        │ 2    │
+        │ null │
+        └──────┘
         """
         if (isinstance(indices, Sequence) and not isinstance(indices, str)) or (
             _check_for_numpy(indices) and isinstance(indices, np.ndarray)
@@ -2934,7 +2957,7 @@ class Expr:
             indices_lit_pyexpr = F.lit(pl.Series("", indices, dtype=Int64))._pyexpr
         else:
             indices_lit_pyexpr = parse_into_expression(indices)
-        return wrap_expr(self._pyexpr.gather(indices_lit_pyexpr))
+        return wrap_expr(self._pyexpr.gather(indices_lit_pyexpr, null_on_oob))
 
     def get(self, index: int | Expr, *, null_on_oob: bool = False) -> Expr:
         """
diff --git a/py-polars/src/polars/series/series.py b/py-polars/src/polars/series/series.py
index 075cb2469..ecf337c63 100644
--- a/py-polars/src/polars/series/series.py
+++ b/py-polars/src/polars/series/series.py
@@ -4051,7 +4051,10 @@ class Series:
         """
 
     def gather(
-        self, indices: int | list_[int] | Expr | Series | np.ndarray[Any, Any]
+        self,
+        indices: int | list_[int] | Expr | Series | np.ndarray[Any, Any],
+        *,
+        null_on_oob: bool = False,
     ) -> Series:
         """
         Take values by index.
@@ -4060,6 +4063,11 @@ class Series:
         ----------
         indices
             Index location used for selection.
+        null_on_oob
+            Behavior if an index is out of bounds:
+
+            - True  -> set the result to null
+            - False -> raise an error
 
         Examples
         --------
@@ -4071,6 +4079,16 @@ class Series:
             2
             4
         ]
+
+        Use `null_on_oob=True` to return null for out-of-bounds indices.
+
+        >>> s.gather([1, 10], null_on_oob=True)
+        shape: (2,)
+        Series: 'a' [i64]
+        [
+            2
+            null
+        ]
         """
 
     def null_count(self) -> int:
diff --git a/py-polars/tests/unit/operations/test_gather.py b/py-polars/tests/unit/operations/test_gather.py
index 0f07e7475..f32e24078 100644
--- a/py-polars/tests/unit/operations/test_gather.py
+++ b/py-polars/tests/unit/operations/test_gather.py
@@ -472,3 +472,17 @@ def test_get_typed_index_default_raises_out_of_bounds(idx_dtype: pl.DataType) ->
 
     with pytest.raises(OutOfBoundsError, match="gather indices are out of bounds"):
         df.select(pl.col("value").get(pl.lit(5, dtype=idx_dtype)))
+
+
+def test_expr_gather_null_on_oob() -> None:
+    df = pl.DataFrame({"a": [1, 2, 3]})
+
+    result = df.select(pl.col("a").gather([0, 1, 10], null_on_oob=True))
+    assert result["a"].to_list() == [1, 2, None]
+
+
+def test_series_gather_null_on_oob() -> None:
+    s = pl.Series("a", [1, 2, 3])
+
+    result = s.gather([0, 1, 10], null_on_oob=True)
+    assert result.to_list() == [1, 2, None]
