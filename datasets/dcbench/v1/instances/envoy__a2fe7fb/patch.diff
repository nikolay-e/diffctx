+    *value_out = {.ptr = nullptr, .length = 0};
+    return false;
+  }
+  auto method = ctx->method();
+  if (method.empty()) {
+    *value_out = {.ptr = nullptr, .length = 0};
+    return false;
+  }
+  *value_out = {.ptr = const_cast<char*>(method.data()), .length = method.size()};
