+  def percentage(x, y) when is_integer(x) and x > 0 and is_integer(y) and y > 0 do
+    result =
+      x
+      |> Decimal.div(y)
+      |> Decimal.mult(100)
+      |> Decimal.round(2)
+      |> Decimal.to_string()
+
+    case result do
+      <<compact::binary-size(1), ".00">> -> compact
+      <<compact::binary-size(2), ".00">> -> compact
+      <<compact::binary-size(3), ".00">> -> compact
+      decimal -> decimal
+    end
+  end
+
+  def percentage(_x, _y) do
+    "0"
+  end
 end
