+fn is_empty(s: &Column, ignore_nulls: bool) -> PolarsResult<Column> {
+    let out = if ignore_nulls {
+        s.is_full_null()
+    } else {
+        s.is_empty()
+    };
+    Ok(Column::new(s.name().clone(), [out]))
