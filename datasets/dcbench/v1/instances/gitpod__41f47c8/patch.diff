+                bind(HostContextProvider).toConstantValue(DevData.createDummyHostContextProvider());
+                bind(AzureDevOpsFileProvider).toSelf().inSingletonScope();
+                bind(AzureDevOpsRepositoryProvider).toSelf().inSingletonScope();
+            }),
+        );
+        return container;
+    }
+}
