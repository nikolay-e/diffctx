+                _lastValue = value;
+                if (!skipNotifications)
+                {
+                    _ignoreComponentPropertyValue = true;
+                    _subscriber.NotifyCascadingValueChanged(ParameterViewLifetime.Unbound);
+                }
+            }
+            else
+            {
