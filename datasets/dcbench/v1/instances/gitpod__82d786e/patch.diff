-// NodeMapToList returns a slice of entry of the map
-func NodeMapToList(m map[string]*Node) []*Node {
-	nodes := make([]*Node, 0, len(m))
-	for _, n := range m {
-		nodes = append(nodes, n)
-	}
-	return nodes
-}
