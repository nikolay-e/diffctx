-			metrics.PodScheduleError(workspaceType, metrics.SinceInSeconds(start))
-			return "", xerrors.Errorf("cannot record scheduling failure: %w", err)
-		}
-
-		// metrics
-		if isError {
-			metrics.PodScheduleError(workspaceType, metrics.SinceInSeconds(start))
-		} else {
-			metrics.PodUnschedulable(workspaceType, metrics.SinceInSeconds(start))
