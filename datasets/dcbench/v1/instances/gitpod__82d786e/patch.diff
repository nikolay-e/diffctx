-		gs := make([]string, 0, len(node.Ghosts))
-		for _, g := range node.Ghosts {
-			gs = append(gs, g.Name)
-		}
-		lines = append(lines, fmt.Sprintf("  ghosts: %s", strings.Join(gs, ", ")))
