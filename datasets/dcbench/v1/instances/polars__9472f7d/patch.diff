+fn is_sorted(
+    s: &Column,
+    descending: Option<bool>,
+    nulls_last: Option<bool>,
+) -> PolarsResult<Column> {
+    let series = s.as_materialized_series();
+    let result = series.is_sorted_any(descending, nulls_last)?;
+    Ok(Column::new(s.name().clone(), [result]))
