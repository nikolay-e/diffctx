     case webview
 
diff --git a/BrowserKit/Sources/Shared/NetworkUtils.swift b/BrowserKit/Sources/Shared/NetworkUtils.swift
index c99fb321c..fd766e225 100644
--- a/BrowserKit/Sources/Shared/NetworkUtils.swift
+++ b/BrowserKit/Sources/Shared/NetworkUtils.swift
@@ -21,6 +21,14 @@ public struct NetworkUtils {
         configuration.multipathServiceType = .handover
         return URLSession(configuration: configuration)
     }
+
+    // Build a URLSession with no-caching suitable for uploading pings
+    public static func defaultGleanPingURLSession() -> URLSession {
+        let sessionConfig = URLSessionConfiguration.default
+        sessionConfig.requestCachePolicy = .reloadIgnoringLocalCacheData
+        sessionConfig.urlCache = nil
+        return URLSession(configuration: sessionConfig)
+    }
 }
 
 public func makeURLSession(
