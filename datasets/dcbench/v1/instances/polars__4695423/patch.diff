+
+        result = df.group_by("g").agg([agg_by(pl.col(c), pl.col(by_col)) for c in cols])
+        expected = df.group_by("g").agg([agg(pl.col(c)) for c in cols])
+        assert_frame_equal(result, expected, check_row_order=False)
