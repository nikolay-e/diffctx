+
+set -x
+set -e
+set -o pipefail
+
+THIS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+ROOT_DIR=$(cd "$THIS_DIR" && hg root)
+
+# Enter xplat
+cd "$ROOT_DIR"/xplat || exit 1
+
+# Setup env
+export TITLE
+TITLE=$(hg log -l 1 --template "{desc|strip|firstline}")
+export REV
