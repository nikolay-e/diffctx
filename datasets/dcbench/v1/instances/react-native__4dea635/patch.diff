+struct PendingEval {
+  debugger::Command command;
+  std::shared_ptr<folly::Promise<facebook::hermes::debugger::EvalResult>>
+      promise;
+  folly::Function<void(const facebook::hermes::debugger::EvalResult &)>
+      resultTransformer;
+};
