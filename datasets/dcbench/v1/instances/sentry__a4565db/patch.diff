+// UI2 loader
+.splash-loader {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  transform: translate(-50%, -50%);
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+
+  .loading-indicator {
+    height: 256px;
+    width: 256px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+
+    animation: none;
+    border: 0;
+    overflow: hidden;
+    border-radius: 0;
+  }
+
+  .loading-message {
+    font-family: @font-family-code;
+    text-align: center;
+  }
+}
+.splash-loader code {
+  margin: 0;
+  padding: 0;
+  border: none;
+  padding-inline: 0.3ch;
+  margin-inline: -0.15ch;
+  border-radius: 2px;
+  text-box-edge: text text;
+  text-box-trim: trim-both;
+
+  color: #C8007E;
+  background: color-mix(in oklab, currentColor, transparent 92%);
+}
+.theme-dark .splash-loader code {
+  color: #EA95B9;
+}
+.splash-loader small {
+  color: #6A6772;
+}
+.theme-dark .splash-loader small {
+  color: #B5B0BD;
+}
