+<Project Sdk="Microsoft.NET.Sdk">
+
+  <PropertyGroup>
+    <TargetFramework>$(DefaultNetCoreTargetFramework)</TargetFramework>
+    <Nullable>enable</Nullable>
+    <IsShippingPackage>true</IsShippingPackage>
+    <IsPackable>true</IsPackable>
+    <GenerateDocumentationFile>true</GenerateDocumentationFile>
+    <!-- NU5100: Tasks DLL is intentionally in tasks/ folder, not lib/ -->
+    <!-- RS0026: New package with no prior shipped API; optional parameter backcompat is N/A -->
+    <NoWarn>$(NoWarn);NU5100;RS0026</NoWarn>
+    <Description>Cross-render-mode E2E testing library for Blazor using Playwright, xUnit V3, and YARP.</Description>
+    <PackageTags>blazor;e2e;testing;playwright</PackageTags>
+  </PropertyGroup>
+
+
+  <ItemGroup>
+    <InternalsVisibleTo Include="Microsoft.AspNetCore.Components.Testing.Tests" />
