 test/functional/ui/float_spec.lua        | 41 +++++-----
 test/functional/ui/sign_spec.lua         | 20 +----
 test/functional/ui/statuscolumn_spec.lua | 95 ++++++++++++------------
 14 files changed, 244 insertions(+), 236 deletions(-)

