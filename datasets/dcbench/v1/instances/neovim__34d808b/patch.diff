 runtime/doc/news.txt                     |  6 +-
 runtime/lua/vim/_meta/api.lua            |  4 +-
 src/nvim/api/vim.c                       | 49 ++++++------
 src/nvim/decoration.c                    |  6 +-
 src/nvim/drawline.c                      | 66 ++++++++--------
 src/nvim/drawscreen.c                    | 24 ++++--
