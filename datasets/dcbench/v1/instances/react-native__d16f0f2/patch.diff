-  if (it == supportedEvents.end()) {
-    return 0;
-  }
-
-  auto reportedName = it->second;
-
-  sCurrentEventTag_++;
-  if (sCurrentEventTag_ == 0) {
-    // The tag wrapped around (which is highly unlikely, but still)
