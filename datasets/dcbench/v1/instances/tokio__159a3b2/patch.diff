-            chunk < self.chunks.len(),
-            "index={}; chunks={}",
-            index,
-            self.chunks.len()
-        );
-        self.chunks[chunk] & mask == mask
-    }
-}
-
-fn num_chunks(max_cores: usize) -> usize {
