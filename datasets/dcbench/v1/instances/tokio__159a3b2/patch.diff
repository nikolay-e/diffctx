-        let cx = maybe_cx.expect("no .is_some() == false cases above should lead here");
-
-        // Get the worker core. If none is set, then blocking is fine!
-        let core = match cx.core.borrow_mut().take() {
-            Some(core) => core,
-            None => return Ok(()),
