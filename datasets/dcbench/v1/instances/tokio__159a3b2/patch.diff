-
-const BITS: usize = usize::BITS as usize;
-const BIT_MASK: usize = (usize::BITS - 1) as usize;
-
-impl IdleMap {
-    fn new(cores: &[Box<Core>]) -> IdleMap {
-        let ret = IdleMap::new_n(num_chunks(cores.len()));
-        ret.set_all(cores);
-
-        ret
-    }
-
-    fn new_n(n: usize) -> IdleMap {
