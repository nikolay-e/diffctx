+          tree.expand(c, true);
+        }
+      });
+
+      expect(tree.build().serialize()).toMatchSnapshot();
+
+      TraceTree.ForEachChild(tree.root, c => {
+        if (isParentAutogroupedNode(c)) {
+          tree.expand(c, false);
