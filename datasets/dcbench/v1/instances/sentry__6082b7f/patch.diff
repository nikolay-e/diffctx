+      TraceTree.FromSpans(
+        tree.root.children[0].children[0],
+        parentAutogroupSpans,
+        makeEventTransaction(),
+        {
+          sdk: undefined,
+        }
+      );
+
+      TraceTree.ForEachChild(tree.root, c => {
