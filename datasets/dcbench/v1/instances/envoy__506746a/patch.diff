+class FileServerConfigTest : public testing::Test {
+public:
+  static ProtoFileServerConfig configFromYaml(absl::string_view yaml) {
+    std::string s(yaml);
+    ProtoFileServerConfig config;
+    TestUtility::loadFromYaml(s, config);
+    return config;
