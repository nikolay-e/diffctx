+class FileServerFilterTest : public testing::Test {
+public:
+  std::shared_ptr<const FileServerConfig> configFromYaml(absl::string_view yaml) {
+    std::string s(yaml);
+    ProtoFileServerConfig proto_config;
+    TestUtility::loadFromYaml(s, proto_config);
