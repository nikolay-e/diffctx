+}
+
+TEST_F(FileServerConfigTest, InvalidFileManagerConfigFailsInMainConfig) {
+  auto mismatched_config = factory()->createFilterFactoryFromProto(configFromYaml(R"(
+manager_config:
+  id: "mismatched"
+  thread_pool:
+    thread_count: 2
+)"),
+                                                                   "stats", mock_factory_context_);
