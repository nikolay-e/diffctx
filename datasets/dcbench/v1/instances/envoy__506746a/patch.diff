+  EXPECT_THAT(
+      response->headers(),
+      AllOf(ContainsHeader(":status", "200"), ContainsHeader("content-type", "text/html"),
+            ContainsHeader("content-length", absl::StrCat(banana_html_contents_.length()))));
+  EXPECT_THAT(response->body(), banana_html_contents_);
+}
