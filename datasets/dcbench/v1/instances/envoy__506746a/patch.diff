+manager_config:
+  id: "mismatched"
+  thread_pool:
+    thread_count: 1
+)"),
+                                                           "stats", mock_factory_context_);
+  EXPECT_THAT(status_or, HasStatus(absl::StatusCode::kInvalidArgument,
