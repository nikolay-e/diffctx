-      - id: black
-        name: black
-        entry: black
+        require_serial: true
+      - id: ruff-format
+        name: ruff format
+        entry: ruff format --force-exclude
         language: system
         types_or: [python, pyi]
         require_serial: true
-      # Configuration for isort exists in pyproject.toml,
