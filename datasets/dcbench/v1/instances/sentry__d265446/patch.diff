-        name: pyupgrade
-        entry: pyupgrade
-        args: ['--py313-plus']
+      # Configuration for ruff exists in pyproject.toml.
+      - id: ruff-check
+        name: ruff check
+        entry: ruff check --force-exclude --fix
         language: system
         types: [python]
