+  def settings_sidebar(assigns) do
+    ~H"""
+    <.settings_top_tab
+      :for={%{key: key, value: value, icon: icon} <- @options}
+      selected_fn={@selected_fn}
+      prefix={@prefix}
+      icon={icon}
+      text={key}
+      value={value}
