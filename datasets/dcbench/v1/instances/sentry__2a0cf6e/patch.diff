+```bash
+#!/bin/bash
+set -e
+
+PROTO_DIR="src/sentry/integrations/grpc/protos"
+OUTPUT_DIR="src/sentry/integrations/grpc/generated"
+CLIENT_DIR="packages/sentry-scm-client"
+
