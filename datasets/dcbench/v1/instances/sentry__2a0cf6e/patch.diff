+  --python_out="${OUTPUT_DIR}" \
+  --grpc_python_out="${OUTPUT_DIR}" \
+  --mypy_out="${OUTPUT_DIR}" \
+  --mypy_grpc_out="${OUTPUT_DIR}" \
+  "${PROTO_DIR}/scm.proto"
