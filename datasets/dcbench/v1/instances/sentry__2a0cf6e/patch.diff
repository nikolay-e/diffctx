+
+# gRPC-Web format: 1 byte flags (0x00 = uncompressed), 4 bytes length, then message
+grpc_web_payload = struct.pack('!BI', 0, len(message_bytes)) + message_bytes
+print(f"gRPC-Web payload: {grpc_web_payload.hex()}")
